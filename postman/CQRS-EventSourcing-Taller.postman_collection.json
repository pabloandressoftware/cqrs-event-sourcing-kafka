  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Las consultas leen un read model eventualmente consistente: pequeña espera para que Kafka entregue el evento",
          "if (pm.request.url.toString().includes('5001') || pm.request.url.toString().includes('queryUrl')) { setTimeout(function(){}, 1500); }"
        ]
      }
    }
