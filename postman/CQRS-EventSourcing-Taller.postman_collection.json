    "name": "CQRS Event Sourcing - Taller (Pablo Guzman A00399523)",
    "description": "Pruebas de todos los endpoints de jrquinte/cqrs-event-sourcing-kafka. Ejecutar en orden: el id de la cuenta se guarda automáticamente en {{accountId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. OpenAccountController",
      "item": [
        {
          "name": "01 Abrir cuenta (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{cmdUrl}}/openBankAccount",
              "host": [
                "{{cmdUrl}}"
              ],
              "path": [
                "openBankAccount"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountHolder\": \"Pablo Guzman\",\n  \"accountType\": \"SAVINGS\",\n  \"openingBalance\": 1000.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Devuelve el id de la cuenta\", function () { pm.expect(pm.response.json().id).to.be.a('string'); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"accountId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Abrir segunda cuenta (POST)",
          "request": {
            "method": "POST",
            "header": [
